# Muse Spark Open 816B-A42B (Meta; mixture of experts with image, video and audio input), NVFP4 weights, snapshot
# 4239e4db1937. Eight B200s, tensor and expert parallel. No vLLM release serves it yet: it runs in Meta's container (a
# vLLM development build with CUDA 13.0), whose vllm is envs/muse/bin/vllm. Its reasoning cannot be turned off: the
# lowest effort ("Reasoning strength: 8" in its system prompt), the muse parser to keep the reasoning out of the answer,
# and a larger token limit to leave room for it.
MODEL=meta-models/Muse-Spark-Open-816B-A42B-NVFP4
REVISION=4239e4db19376904f2e82c167e78f70abb5455fe
SERVED_NAME=muse-spark-open
PORT=8014
GPU_FRACTION=0.90
MAX_LEN=131072
KV_BYTES=34359738368
VLLM_ENV=muse
CONTAINER=muse-spark-open.sif
MAX_TOKENS=1024
EXTRA_ARGS='--tensor-parallel-size 8 --enable-expert-parallel --max-num-seqs 4 --max-num-batched-tokens 16384 --limit-mm-per-prompt {"image":300,"video":0,"audio":0} --mm-processor-cache-gb 4 --reasoning-parser muse'
REQUEST_EXTRA='{"reasoning_effort": "low", "chat_template_kwargs": {"reasoning_effort": "low"}}'
