# Muse Spark Open 816B-A42B (Meta; mixture of experts with image, video and audio input), NVFP4 weights, snapshot
# 4239e4db1937. Four B200s, tensor and expert parallel (the weights take ~116 GiB per GPU). No vLLM release serves it
# yet: it runs in Meta's container (a vLLM development build with CUDA 13.0), whose vllm is envs/muse/bin/vllm. Its
# reasoning cannot be turned off: the lowest effort ("Reasoning strength: 8" in its system prompt), the muse parser to
# keep the reasoning out of the answer, and no limit on the reply but the context. Sampling as Meta recommends
# (temperature 1.0, top-p 1.0, no top-k), with the repeat's seed. Replies are long, so it takes more sequences at once
# than the other readers.
MODEL=meta-models/Muse-Spark-Open-816B-A42B-NVFP4
REVISION=4239e4db19376904f2e82c167e78f70abb5455fe
SERVED_NAME=muse-spark-open
PORT=8014
GPU_FRACTION=0.90
MAX_LEN=131072
KV_BYTES=17179869184
VLLM_ENV=muse
CONTAINER=muse-spark-open.sif
MAX_TOKENS=0
EXTRA_ARGS='--tensor-parallel-size 4 --enable-expert-parallel --max-num-seqs 16 --max-num-batched-tokens 16384 --limit-mm-per-prompt {"image":300,"video":0,"audio":0} --mm-processor-cache-gb 4 --reasoning-parser muse'
ANSWER_SCHEMA=1
REQUEST_EXTRA='{"temperature": 1.0, "top_p": 1.0, "top_k": -1, "reasoning_effort": "low", "chat_template_kwargs": {"reasoning_effort": "low"}}'
