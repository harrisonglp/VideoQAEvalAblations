# Gemma 4 31B with thinking on: the same weights, server and context as gemma4-31b (which stays the fixed judge, with
# thinking off). The gemma4 reasoning parser keeps the thoughts out of the answer, so the answer schema applies once
# thinking ends. No answer limit: a reply may use the rest of the context. Sampling as Google recommends (temperature
# 1.0, top-p 0.95, top-k 64; greedy decoding makes its thinking loop until the context is full), with the repeat's seed.
# Long replies, so more sequences at once.
MODEL=google/gemma-4-31B-it
REVISION=842da3794eaa0b77d5f08bae87a17459d91ff475
SERVED_NAME=gemma4-31b-think
PORT=8015
GPU_FRACTION=0.90
MAX_LEN=131072
KV_BYTES=103079215104
VLLM_ENV=vllm32
EXTRA_ARGS='--max-num-seqs 16 --max-num-batched-tokens 16384 --limit-mm-per-prompt {"image":300,"video":0} --mm-processor-cache-gb 4 --attention-backend TRITON_ATTN --reasoning-parser gemma4'
WARMUP_CALLS=2
ANSWER_SCHEMA=1
MAX_TOKENS=0
REQUEST_EXTRA='{"temperature": 1.0, "top_p": 0.95, "top_k": 64, "chat_template_kwargs": {"enable_thinking": true}}'
