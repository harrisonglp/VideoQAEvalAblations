# Nemotron 3.5 Super VL with thinking on: the same weights, server and context as nemotron35-super-vl. The
# nemotron_v3 reasoning parser keeps the thoughts out of the answer, so the answer schema applies once thinking ends.
# No answer limit: a reply may use the rest of the context. Sampling as NVIDIA recommends for vision (temperature 0.6,
# top-p 0.95, no top-k), in every condition, with the repeat's seed. Long replies, so more sequences at once.
MODEL=nvidia/NVIDIA-Nemotron-3.5-Super-VL-120B-A12B-NVFP4
REVISION=59b8721646c38111a242da18218859fb2b454322
SERVED_NAME=nemotron35-super-vl-think
PORT=8016
GPU_FRACTION=0.90
MAX_LEN=131072
KV_BYTES=34359738368
VLLM_ENV=vllm32
EXTRA_ARGS='--max-num-seqs 16 --max-num-batched-tokens 16384 --limit-mm-per-prompt {"image":300,"video":0} --mm-processor-cache-gb 4 --trust-remote-code --reasoning-parser nemotron_v3'
ANSWER_SCHEMA=1
MAX_TOKENS=0
REQUEST_EXTRA='{"temperature": 0.6, "top_p": 0.95, "top_k": -1, "chat_template_kwargs": {"enable_thinking": true}}'
