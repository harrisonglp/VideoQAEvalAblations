# Gemma 4 31B (Google; dense vision-language model), BF16 weights, snapshot 842da3794eaa. One B200: 128k context,
# 96 GiB fixed KV cache. Gemma's wide global-attention heads need the Triton attention backend on Blackwell. Its
# sliding-window layers let a film's prefix be reused only from the third request on, so two warm-up calls per film.
# Thinking is off unless the system prompt asks for it, so no request options are needed.
MODEL=google/gemma-4-31B-it
REVISION=842da3794eaa0b77d5f08bae87a17459d91ff475
SERVED_NAME=gemma4-31b
PORT=8011
GPU_FRACTION=0.90
MAX_LEN=131072
KV_BYTES=103079215104
VLLM_ENV=vllm32
EXTRA_ARGS='--max-num-seqs 4 --max-num-batched-tokens 16384 --limit-mm-per-prompt {"image":300,"video":0} --mm-processor-cache-gb 4 --attention-backend TRITON_ATTN'
WARMUP_CALLS=2
ANSWER_SCHEMA=1
REQUEST_EXTRA='{}'
